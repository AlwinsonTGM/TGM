    {
      "name": "Primary button",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "The mint-filled action used to save or start.",
      "html": "<button class=\"ds-primary\" type=\"button\">Save goal</button>",
      "css": ".ds-primary{font:14px \"Segoe UI\",Arial,sans-serif;cursor:pointer;transition:background-color 140ms ease,border-color 140ms ease;padding:10px 15px;color:var(--ink,#09251b);background:var(--teal,#61d8b8);border:1px solid var(--teal,#61d8b8);border-radius:7px;font-weight:700}.ds-primary:hover:not(:disabled){background:#8ae8ce}.ds-primary:focus-visible{outline:2px solid #77e5c9;outline-offset:3px;}.ds-primary:disabled{cursor:not-allowed;opacity:.55}@media(prefers-reduced-motion:reduce){.ds-primary{transition:none}}"
    },
    {
      "name": "Outline button",
      "kind": "button",
      "refersTo": "button-outline",
      "description": "A quieter action used to open an item or choose a folder.",
      "html": "<button class=\"ds-outline\" type=\"button\">Open <svg class=\"ds-icon\" aria-hidden=\"true\" viewBox=\"0 0 24 24\"><path d=\"M4 12h15M14 7l5 5-5 5\"/></svg></button>",
      "css": ".ds-outline{font:14px \"Segoe UI\",Arial,sans-serif;cursor:pointer;transition:background-color 140ms ease,border-color 140ms ease;display:inline-flex;align-items:center;justify-content:space-between;gap:12px;min-width:78px;padding:9px 13px;color:#edf4ea;background:transparent;border:1px solid #4e715e;border-radius:7px}.ds-outline:hover:not(:disabled){background:#204937}.ds-outline:focus-visible{outline:2px solid #77e5c9;outline-offset:3px;}.ds-outline:disabled{cursor:not-allowed;opacity:.55}.ds-icon{width:15px;height:15px;fill:none;stroke:var(--gold,#d9bf80);stroke-width:1.55;stroke-linecap:round;stroke-linejoin:round}@media(prefers-reduced-motion:reduce){.ds-outline{transition:none}}"
    },
    {
      "name": "Text action",
      "kind": "button",
      "description": "A quiet inline action for secondary navigation and disclosure.",
      "html": "<button class=\"ds-text\" type=\"button\">Add goal</button>",
      "css": ".ds-text{font:14px \"Segoe UI\",Arial,sans-serif;cursor:pointer;transition:background-color 140ms ease,border-color 140ms ease;padding:4px 0;border:0;background:transparent;color:#d3e3d4}.ds-text:hover{color:#fff;text-decoration:underline;text-underline-offset:3px}.ds-text:focus-visible{outline:2px solid #77e5c9;outline-offset:3px;}.ds-text:disabled{cursor:not-allowed;opacity:.55}@media(prefers-reduced-motion:reduce){.ds-text{transition:none}}"
    },
    {
      "name": "Text field",
      "kind": "input",
      "refersTo": "input",
      "description": "The bordered field used for goals and quick capture.",
      "html": "<label class=\"ds-label\" for=\"ds-goal\">Goal</label><input class=\"ds-input\" id=\"ds-goal\" placeholder=\"What would you like to work toward?\">",
      "css": ".ds-label{display:block;margin-bottom:8px;color:#d9e6d9;font:12px \"Segoe UI\",Arial,sans-serif}.ds-input{box-sizing:border-box;width:100%;min-width:0;padding:11px 12px;color:#e9eee5;background:#0b231b;border:1px solid #466753;border-radius:7px;font:14px \"Segoe UI\",Arial,sans-serif;caret-color:#83dfc7}.ds-input::placeholder{color:#afc2b2;opacity:1}.ds-input:focus-visible{outline:2px solid #77e5c9;outline-offset:3px;}"
    },
