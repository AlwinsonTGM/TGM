      "html": "<nav aria-label=\"Sections\"><button class=\"ds-nav\" type=\"button\" aria-current=\"page\"><svg class=\"ds-nav-icon\" aria-hidden=\"true\" viewBox=\"0 0 24 24\"><path d=\"M3 11.5 12 4l9 7.5\"/><path d=\"M6 10v9h12v-9M10 19v-5h4v5\"/></svg>Home</button></nav>",
      "css": ".ds-nav{font:14px \"Segoe UI\",Arial,sans-serif;cursor:pointer;transition:background-color 140ms ease,border-color 140ms ease;display:flex;align-items:center;gap:13px;width:100%;padding:12px;border:0;border-radius:8px;text-align:left;color:#f0f2e8;background:#153c2c}.ds-nav:hover{background:#17382b}.ds-nav:focus-visible{outline:2px solid #77e5c9;outline-offset:3px;}.ds-nav-icon{width:18px;height:18px;flex:none;fill:none;stroke:var(--gold,#d9bf80);stroke-width:1.55;stroke-linecap:round;stroke-linejoin:round}@media(prefers-reduced-motion:reduce){.ds-nav{transition:none}}"
