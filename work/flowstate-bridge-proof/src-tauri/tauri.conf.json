{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "FlowState",
  "version": "0.1.0",
  "identifier": "com.flowstate.app",
  "build": {
    "beforeDevCommand": "bun run dev",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "overlay",
        "title": "FlowPill",
        "width": 460,
        "height": 48,
        "minWidth": 320,
        "minHeight": 44,
        "maxWidth": 560,
        "maxHeight": 56,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "shadow": false,
        "resizable": true,
        "url": "index.html"
      },
      {
        "label": "snip",
        "title": "FlowState Snip",
        "fullscreen": true,
        "visible": false,
        "transparent": true,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "shadow": false,
        "resizable": false,
        "url": "index.html?window=snip"
      },
      {
        "label": "alarm",
        "title": "FlowState Alert",
        "width": 420,
        "height": 260,
        "visible": false,
        "transparent": true,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "shadow": false,
        "resizable": false,
        "center": true,
        "url": "index.html?window=alarm"
      },
      {
        "label": "main",
        "title": "FlowState - 24h Timeline & Focus Dashboard",
        "width": 1080,
        "height": 720,
        "minWidth": 360,
        "minHeight": 560,
        "visible": true,
        "center": true,
        "resizable": true,
        "decorations": true,
        "url": "index.html"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
